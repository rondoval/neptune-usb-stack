; Neptune - Installer
; Commodore Installer script. Run from a Shell:  Installer Install
;
; Installs (into the running system):
;   neptune.library              -> LIBS:
;   the USB device classes        -> DEVS:USBClasses/
;   the CLI tools                 -> C:
;   Neptune USB (the control panel)   -> SYS:Prefs/
;   USBEject (safe-eject menu)    -> SYS:WBStartup/     (optional)
;   the per-gadget Tools          -> SYS:Tools/         (optional)
;   the localized catalogs        -> LOCALE:Catalogs/   (if LOCALE: exists)
; and optionally wires the startup commands into S:User-Startup.

(set #product "Neptune")

; The S:User-Startup block marker. (startup) finds the existing ";BEGIN <name>"/";END <name>"
; pair by this string and rewrites it, so it stays the same from release to release; a new
; marker leaves the old block in place and appends a second one. 6.0-6.2, published as
; "Poseidon for AmigaOS", used the old marker; that block is disabled below.
(set #startupname "Neptune USB Stack")
(set #oldstartupname "Poseidon USB Stack")

; 1 when LIBS: holds poseidon.library 6.x, i.e. a 6.0-6.2 release is installed. getversion
; packs the version in the high 16 bits (6 << 16 = 393216) and returns 0 for a missing file.
; A classic (4.x) Poseidon reports less and is never touched.
(set #oldrelease (>= (getversion "LIBS:poseidon.library") 393216))
; 1 when LIBS: holds a classic (4.x) poseidon.library. Its installer takes over the old block
; in S:User-Startup for its own start command, so that block is then left alone.
(set #classic (AND (> (getversion "LIBS:poseidon.library") 0) (NOT #oldrelease)))

;==========================================================================
; Installer version gate.
;   The class, tool and catalog installs below are driven by (foreach), which with
;   @installer-version packs the version in the high 16 bits: 43 << 16 = 2818048.
;   An Installer too old to define the symbol at all evaluates it as 0 and so aborts
;   here too, which is the outcome we want.
;   Note that Installer 45.5 and newer deliberately report themselves as 43, so this
;   is a ">= 43" test and not an equality one.
;==========================================================================
(if (< @installer-version 2818048)
    (abort #product " needs Installer 43.3 or newer; this one is older.\n\n"
           "Installer 43.3 is freely distributable and is on Aminet as "
           "util/misc/Installer-43_3.lha. Copy it over C:Installer (or run it from "
           "wherever you unpack it) and start this script again.\n\n"
           "Nothing has been installed.")
)

(welcome #product " is a USB stack for AmigaOS 3.1 and newer, forked from Poseidon; "
         "Poseidon's classes and tools do not work with it.\n\n"
         "The USB host-controller driver, such as xhci.device from the Emu68 driver "
         "stack, is installed separately.")

;==========================================================================
; neptune.library -> LIBS:
;==========================================================================
(complete 5)
(copylib
    (prompt "Installing neptune.library into LIBS:")
    (help @copylib-help)
    (source "LIBS/neptune.library")
    (dest "LIBS:")
    (confirm "expert")
)

;==========================================================================
; USB device classes -> DEVS:USBClasses/   (version-checked, never downgraded)
;   foreach over the packaged classes + copylib each, so a class already present in a
;   newer version is kept. Driven off the drawer's contents, so new classes need no edit.
;==========================================================================
(complete 20)
(makedir "DEVS:USBClasses" (prompt "Creating DEVS:USBClasses") (help @makedir-help))
(foreach "DEVS/USBClasses" "#?.usbclass"
    (copylib
        (prompt "Installing " @each-name " into DEVS:USBClasses/")
        (help @copylib-help)
        (source (tackon "DEVS/USBClasses" @each-name))
        (dest "DEVS:USBClasses")
        (confirm "expert")
    )
)

;==========================================================================
; CLI tools -> C:   (version-checked, never downgraded - each carries a $VER)
;==========================================================================
(complete 40)
(foreach "C" "#?"
    (copylib
        (prompt "Installing " @each-name " into C:")
        (help "These commands bring the stack up and inspect it:\n\n"
              "  USBStart        - start the stack (the one startup command)\n"
              "  USBAddHardware  - attach a host-controller device by hand\n"
              "  USBAddClasses   - load the classes from DEVS:USBClasses/ by hand\n"
              "  USBList         - list the connected USB devices\n"
              "  USBErrorlog     - show the stack error log\n\n" @copylib-help)
        (source (tackon "C" @each-name))
        (dest "C:")
        (confirm "expert")
    )
)

;==========================================================================
; Neptune USB (the MUI control panel) + the USB attach/detach sounds -> SYS:Prefs/
;   Prefs/NeptuneUSB                          -> SYS:Prefs/NeptuneUSB            (version-checked)
;   Prefs/NeptuneUSB.info  Prefs/Presets/...  -> SYS:Prefs/                   (icon + sounds, no $VER)
; The executable goes via copylib (it carries a $VER, so a newer one is kept); the icon and
; the sound presets have no version, so they ride along with copyfiles (~(NeptuneUSB) = all but it).
;==========================================================================
(complete 55)
; The settings import rewrites sound paths under SYS:Prefs/Presets/Poseidon/ to
; SYS:Prefs/Presets/Neptune/, so sounds the user added there are carried across first. The
; bundled defaults are copied after them and replace their old copies.
(if (= (exists "SYS:Prefs/Presets/Poseidon" (noreq)) 2)
    (
        (makedir "SYS:Prefs/Presets/Neptune" (prompt "Creating SYS:Prefs/Presets/Neptune") (help @makedir-help))
        (copyfiles
            (prompt "Copying your USB sounds from SYS:Prefs/Presets/Poseidon/ to SYS:Prefs/Presets/Neptune/")
            (help @copyfiles-help)
            (source "SYS:Prefs/Presets/Poseidon")
            (dest "SYS:Prefs/Presets/Neptune")
            (all)
            (optional "nofail"))
    )
)
(copylib
    (prompt "Installing Neptune USB (the control panel) into SYS:Prefs/")
    (help "Neptune USB is the control panel for the USB stack.\n\n" @copylib-help)
    (source "Prefs/NeptuneUSB")
    (dest "SYS:Prefs")
    (confirm "expert")
)
(copyfiles
    (prompt "Installing Neptune USB's icon and the USB attach/detach sounds into SYS:Prefs/")
    (help "Connect.iff / Disconnect.iff are the default sounds played when a USB device is "
          "plugged in or removed (SYS:Prefs/Presets/Neptune/).\n\n" @copyfiles-help)
    (source "Prefs")
    (dest "SYS:Prefs")
    (pattern "~(NeptuneUSB)")
)

;==========================================================================
; Localized catalogs -> LOCALE:Catalogs/   (only if locale is set up)
;==========================================================================
(complete 65)
(if (exists "LOCALE:" (noreq))
    (copyfiles
        (prompt "Installing the Neptune USB catalogs (translations) into LOCALE:Catalogs/")
        (help "Neptune USB speaks English by default. The catalogs add other "
              "languages; they are only used if your Locale language matches.\n\n"
              @copyfiles-help)
        (source "Catalogs")
        (dest "LOCALE:Catalogs")
        (all)
        (optional "askuser" "nofail")
    )
)

;==========================================================================
; Optional parts, chosen together on one screen. Bits of #extras:
;   0  USBEject (safe-eject Workbench menu)       -> SYS:WBStartup/
;   1  the VHI driver for UVC devices             -> LIBS:VHI/
;   2  settings-file datatype + default icon      -> DEVS:DataTypes/, ENV(ARC):SYS/
;   3  the per-gadget Tools                       -> SYS:Tools/
;==========================================================================
(complete 70)
(set #extras
    (askoptions
        (prompt "Which optional parts should be installed?")
        (help "USBEject adds a 'USB' menu to the Workbench menu bar with an 'Eject' item "
              "per USB drive, like Windows' 'Safely Remove Hardware'. It flushes and "
              "unmounts all volumes (refusing while files are open) before the drive is "
              "unplugged. It goes into SYS:WBStartup so it starts with Workbench; the same "
              "eject is also available from Neptune USB's Devices page.\n\n"
              "neptune.vhi lets VHI programs such as cAMIra and VHI Studio use webcams, "
              "video grabbers and other USB Video Class devices. It goes into LIBS:VHI/ and "
              "needs no setup; without a VHI program it is simply unused.\n\n"
              "The settings-file icon adds a 'Neptune' datatype and a default Workbench icon, "
              "so your saved USB settings files show an icon instead of none. It relies on "
              "the DefIcons component, which is standard from AmigaOS 3.5 onwards; on 3.1 it "
              "is a separate install, and without it this is simply inert.\n\n"
              "The gadget tools are small command-line utilities for specific USB devices: "
              "USBRadio, USBPencam, USBPowMan, USBRocket, USBSonixcam, USBUPS and USBVideo "
              "(for UVC devices). They go into SYS:Tools/; install them only if you own the "
              "matching hardware.\n\n"
              "None of these is needed for the stack itself.")
        (choices "USBEject: safe-eject menu on Workbench"
                 "neptune.vhi: USB webcams in VHI programs"
                 "Settings-file icon (needs DefIcons)"
                 "Tools for specific USB gadgets")
        (default 7)))

(if (in #extras 0)
    (
        (makedir "SYS:WBStartup" (prompt "Creating SYS:WBStartup") (help @makedir-help))
        (copylib
            (prompt "Installing USBEject into SYS:WBStartup/")
            (help @copylib-help)
            (source "WBStartup/USBEject")
            (dest "SYS:WBStartup")
            (confirm "expert"))
        (copyfiles
            (prompt "Installing the USBEject icon into SYS:WBStartup/")
            (help @copyfiles-help)
            (source "WBStartup")
            (dest "SYS:WBStartup")
            (pattern "USBEject.info"))
    )
)

(complete 73)
(if (in #extras 1)
    (
        (makedir "LIBS:VHI" (prompt "Creating LIBS:VHI") (help @makedir-help))
        (copylib
            (prompt "Installing neptune.vhi into LIBS:VHI/")
            (help @copylib-help)
            (source "LIBS/VHI/neptune.vhi")
            (dest "LIBS:VHI")
            (confirm "expert"))
    )
)

; DEVS/DataTypes/Neptune  -> DEVS:DataTypes/Neptune  (datatypes identifies FORM..NEPC files)
; Icons/def_Neptune.info  -> ENVARC:SYS/ + ENV:SYS/  (the icon Workbench paints on them)
(complete 75)
(if (in #extras 2)
    (
        (makedir "DEVS:DataTypes" (prompt "Creating DEVS:DataTypes") (help @makedir-help))
        (copyfiles
            (prompt "Installing the Neptune datatype into DEVS:DataTypes/")
            (help @copyfiles-help)
            (source "DEVS/DataTypes")
            (dest "DEVS:DataTypes")
            (all))
        (copyfiles
            (prompt "Installing the default preset-file icon into ENVARC:SYS/")
            (help @copyfiles-help)
            (source "Icons")
            (dest "ENVARC:SYS")
            (pattern "def_#?.info"))
        (copyfiles
            (prompt "...and into ENV:SYS/ (so it takes effect without a reboot)")
            (help @copyfiles-help)
            (source "Icons")
            (dest "ENV:SYS")
            (pattern "def_#?.info"))
    )
)

(complete 80)
(if (in #extras 3)
    (
        (makedir "SYS:Tools" (prompt "Creating SYS:Tools") (help @makedir-help))
        (foreach "Tools" "#?"
            (copylib
                (prompt "Installing " @each-name " into SYS:Tools/")
                (help @copylib-help)
                (source (tackon "Tools" @each-name))
                (dest "SYS:Tools")
                (confirm "expert")))
    )
)

;==========================================================================
; Superseded 6.0-6.2 releases (published as "Poseidon for AmigaOS")
;   Their S:User-Startup block is reduced to a comment, so the old stack is not started next
;   to Neptune and the boot does not stop on a removed command. Search returns 0 only when
;   the marker is present; without the test (startup) would add an empty block of that name.
;   With a classic Poseidon installed the block is its own (see #classic) and stays.
;   Then the old files are removed on request. Files with a version are removed only if they
;   report 6 or newer; the unversioned ones (catalogs, sounds, datatype, icon) only when the
;   6.x library is installed. poseidon.prefs is kept: Neptune imports it.
;==========================================================================
(complete 82)
(if (AND (NOT #classic)
         (= 0 (run (cat "C:Search >NIL: S:User-Startup \";BEGIN " #oldstartupname "\"") (safe))))
    (startup #oldstartupname
        (prompt "Disable the Poseidon for AmigaOS 6.x start command in S:User-Startup?\n\n"
                "Neptune replaces it. Left in place, it starts the old stack as well.")
        (help @startup-help)
        (command "; Disabled by the Neptune installer.\n"))
)

; P_delv6 - delete a file if it reports version 6 or newer (a 6.x release file).
(procedure P_delv6 #dv_file
    (if (>= (getversion #dv_file) 393216)
        (delete #dv_file (optional "force" "nofail")))
)

; P_oldclass - the name a class had up to 6.3 development: "hid.usbclass" -> "hid.class".
(procedure P_oldclass #oc_name
    (cat (substr #oc_name 0 (- (strlen #oc_name) 9)) ".class")
)

; P_del - delete a file or an empty drawer, if present (a drawer that is not empty stays).
(procedure P_del #dl_file
    (if (exists #dl_file (noreq))
        (delete #dl_file (optional "force" "nofail")))
)

(if #oldrelease
    (if (askbool
            (prompt "Remove the files of Poseidon for AmigaOS 6.x?\n\n"
                    "Neptune replaces releases 6.0 to 6.2, which were published as "
                    "'Poseidon for AmigaOS'. Their files are no longer used:\n\n"
                    "  LIBS:poseidon.library\n"
                    "  the classes in SYS:Classes/USB/\n"
                    "  C:PsdStackLoader, PsdDevLister, PsdErrorlog\n"
                    "  SYS:Prefs/Trident and its catalogs\n"
                    "  the PSD datatype, its icon and the old sounds\n\n"
                    "Your settings in ENVARC:Sys/poseidon.prefs are kept.")
            (help "Only files of the 6.x releases are removed: anything that reports a "
                  "version below 6, such as a classic Poseidon, is left alone. Neptune "
                  "does not use any of these files, and it imports poseidon.prefs on "
                  "first start.")
            (default 1))
        (
            (P_delv6 "LIBS:poseidon.library")
            ; Driven off the archive's class list (a superset of every 6.x class), so the
            ; drawer being emptied is not also the one being scanned.
            (foreach "DEVS/USBClasses" "#?.usbclass"
                (P_delv6 (tackon "SYS:Classes/USB" (P_oldclass @each-name))))
            (P_del "SYS:Classes/USB")
            (P_delv6 "C:PsdStackLoader")
            (P_delv6 "C:PsdDevLister")
            (P_delv6 "C:PsdErrorlog")
            (if (>= (getversion "SYS:Prefs/Trident") 393216)
                (
                    (P_delv6 "SYS:Prefs/Trident")
                    (P_del "SYS:Prefs/Trident.info")
                )
            )
            (foreach "Catalogs" "#?"
                (P_del (tackon "LOCALE:Catalogs" (tackon @each-name "System/Prefs/Trident.catalog"))))
            (P_del "SYS:Prefs/Presets/Poseidon/Connect.iff")
            (P_del "SYS:Prefs/Presets/Poseidon/Disconnect.iff")
            (P_del "SYS:Prefs/Presets/Poseidon")
            (P_del "DEVS:DataTypes/PSD")
            (P_del "ENVARC:SYS/def_PSD.info")
            (P_del "ENV:SYS/def_PSD.info")
        )
    )
)

; Commands and tools that carried Poseidon's names up to 6.2 (USBAddHardware, USBAddClasses
; and USB<gadget> now). Only 6.x copies go; a classic Poseidon's own are left alone.
(P_delv6 "C:AddUSBHardware")
(P_delv6 "C:AddUSBClasses")
(P_delv6 "SYS:Tools/DRadioTool")
(P_delv6 "SYS:Tools/PencamTool")
(P_delv6 "SYS:Tools/PowManTool")
(P_delv6 "SYS:Tools/RocketTool")
(P_delv6 "SYS:Tools/SonixcamTool")
(P_delv6 "SYS:Tools/UPSTool")

; Classes are <name>.usbclass now; 6.x copies under the old <name>.class in the class drawer
; (left by a 6.3 development install) go. The drawer scan would skip them anyway.
(foreach "DEVS/USBClasses" "#?.usbclass"
    (P_delv6 (tackon "DEVS:USBClasses" (P_oldclass @each-name))))

;==========================================================================
; Auto-start
;==========================================================================
(complete 85)
(set #startmode
    (askchoice
        (prompt "How should the USB stack be started at boot?")
        (help "'S:User-Startup' runs the start command early on every boot "
              "(recommended).\n\n"
              "'Manual' installs nothing extra - you start the stack yourself by "
              "running USBStart <device> <unit> (e.g. from a shell or your own "
              "script).")
        (choices "Add to S:User-Startup (recommended)"
                 "Manual - don't auto-start")
        (default 0)))

(if (= #startmode 0)
    (
        (set #port
            (askchoice
                (prompt "Which USB ports should the stack start?")
                (help "On a PiStorm with a Raspberry Pi 4B or CM4, xhci.device (installed "
                      "separately with the Emu68 driver stack) drives two sets of ports:\n\n"
                      "Unit 0 is the onboard OTG port: the USB-C port of a Pi 4B, the USB "
                      "port of a CM4. It needs otg_mode=1 in the Pi's config.txt.\n\n"
                      "Unit 1 is the controller behind the four USB-A ports of a Pi 4B (on "
                      "a CM4, a PCIe USB card). It needs bcmpcie.library.\n\n"
                      "'Other' asks for the name and unit of any other host-controller "
                      "device.\n\n"
                      "This only starts the stack on a machine without saved settings: once "
                      "you have chosen a controller in Neptune USB and saved, that one is used.")
                (choices "xhci.device unit 0: USB-C (OTG) port"
                         "xhci.device unit 1: USB-A ports (Pi 4B)"
                         "Other device or unit")
                (default 1)))
        (if (= #port 2)
            (
                (set #hcd
                    (askstring
                        (prompt "Name of your USB host-controller device:")
                        (help "This is the device the USB host controller is driven by.")
                        (default "xhci.device")))
                (set #unit
                    (asknumber
                        (prompt "Unit number of " #hcd ":")
                        (help "Which unit of the host-controller device to attach. With a "
                              "single USB controller this is 0 (the default). Increase it "
                              "only if you have several controllers and want a specific one.")
                        (default 0)))
            )
            ; The first two choices are xhci.device units 0 and 1.
            (
                (set #hcd "xhci.device")
                (set #unit #port)
            )
        )
        (startup #startupname
            (prompt "Add the Neptune startup command to S:User-Startup?")
            (help @startup-help)
            ; One command starts the stack. The device and unit are its fallback for a
            ; machine with no saved settings; once Neptune USB has saved a controller, or on
            ; a ROM-started stack, they are not used.
            ; >NIL: keeps the boot quiet. AmigaDOS takes the redirection only straight
            ; after the command name, so it goes before the arguments.
            (command (cat "C:USBStart >NIL: " #hcd " " #unit "\n")))
    )
)

(complete 100)
(message #product " has been installed.\n\n"
         (if (= #startmode 0)
             "Reboot to start the USB stack, then open Neptune USB from SYS:Prefs/ to see your devices."
             "Start the stack with USBStart <device> <unit>, then open Neptune USB from SYS:Prefs/.")
         (all))
(exit (quiet))
